#!/usr/bin/env python3
"""run_tests: run the tests in ./tests against solution.py and show a short report.

Usage: run_tests [extra pytest arguments]

Example: run_tests -k empty
"""

import subprocess
import sys

MAX_CHARS = 6000


def main() -> int:
    if "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    cmd = [sys.executable, "-m", "pytest", "tests", "-q", "--no-header", "-rfE", "--tb=short", "-p", "no:cacheprovider"]
    result = subprocess.run(cmd + sys.argv[1:], capture_output=True, text=True, timeout=300)
    output = (result.stdout + result.stderr).strip()
    if len(output) > MAX_CHARS:
        output = "...(output truncated)...\n" + output[-MAX_CHARS:]
    print(output)
    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
